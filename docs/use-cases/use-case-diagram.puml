@startuml UseCaseDiagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Khách hàng\n(Customer)" as Customer
actor "Cổng Thanh toán\n(VNPay / MoMo)" as PaymentGateway
actor "Hệ thống Notification\n(Email / SMS)" as Notifier
actor "Hệ thống Kho\n(Inventory)" as Inventory

rectangle "Hệ thống Quản lý Bán hàng & TMĐT" {
    usecase "UC-01: Duyệt & Chọn sản phẩm" as UC1
    usecase "UC-02: Tùy biến & Xây dựng Đơn hàng\n**(Builder Pattern)**" as UC2
    usecase "UC-03: Tính giá, Chiết khấu & Phí dịch vụ\n**(Strategy & Decorator Pattern)**" as UC3
    usecase "UC-04: Xử lý Thanh toán Đa cổng\n**(Factory Method & Adapter Pattern)**" as UC4
    usecase "UC-05: Cập nhật Trạng thái & Phát Sự kiện\n**(Observer Pattern)**" as UC5

    UC2 .> UC3 : <<include>>
    UC4 .> UC5 : <<triggers on PAID>>
}

Customer --> UC1
Customer --> UC2
Customer --> UC4

UC4 --> PaymentGateway
UC5 --> Notifier
UC5 --> Inventory

@enduml
